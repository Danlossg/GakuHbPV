    pulseTween = nil,
    connections = {},
    shieldConnections = {},
    shieldedScreens = setmetatable({}, {__mode = "k"}),
    relatedScreens = setmetatable({}, {__mode = "k"})
}

ENV[STATE_KEY] = State

local function keep(connection)
    table.insert(State.connections, connection)
    return connection
end

local function clearConnections()
    for _, connection in ipairs(State.connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(State.connections)
end

local function getRoots()
    local result = {}
    local seen = {}

    local function add(obj)
        if obj and not seen[obj] then
            seen[obj] = true
            table.insert(result, obj)
        end
    end

    pcall(function()
        if gethui then
            add(gethui())
        end
    end)

    add(PlayerGui)
    add(CoreGui)

    return result
end

local function getGuiParent()
    local parent = PlayerGui

    pcall(function()
        if gethui then
            local hui = gethui()
            if hui then
                parent = hui
            end
        end
    end)

    return parent
end

local function getText(obj)
    if obj and (
        obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
    ) then
        local ok, value = pcall(function()
            return obj.Text
        end)

        if ok then
            return tostring(value or "")
        end
    end

    return ""
end

local function getScreenGui(obj)
    local current = obj

    while current do
        if current:IsA("ScreenGui") then
            return current
        end

        current = current.Parent
    end

    return nil
end


local function isDanloHubPlusLauncherScreen(screen)
    if not screen or not screen:IsA("ScreenGui") then
        return false
    end

    -- Base modular v3 marks itself explicitly.
    local ok, marked = pcall(function()
        return screen:GetAttribute("DanloHubPlusLauncher") == true
    end)

    if ok and marked then
        return true
    end

    -- Compatibility with v1/v2 launcher names.
    local name = tostring(screen.Name or "")

    if name == "DanloHubPlus_Base"
        or string.find(name, "DanloHubPlus", 1, true)
        or string.find(name, "DanloHubPlus_Base", 1, true) then
        return true
    end

    -- Last-resort semantic guard:
    -- if this ScreenGui contains the DANLOHUB + title, it is the launcher,
    -- NOT the original Bundle Animations GUI.
    for _, obj in ipairs(screen:GetDescendants()) do
        if string.upper(getText(obj)) == "DANLOHUB +" then
            return true
        end
    end

    return false
end

local function addCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
end

local function getLogoAsset()
    if ENV.__DanloHubLogoAsset then
        return ENV.__DanloHubLogoAsset
    end

    local asset = nil

    local function resolveLocal()
        if getsynasset then
            local ok, value = pcall(function()
                return getsynasset(LOGO_FILE)
            end)

            if ok and value then
                return value
            end
        end

        if getcustomasset then
            local ok, value = pcall(function()
                return getcustomasset(LOGO_FILE)
            end)

            if ok and value then
                return value
            end
        end

        return nil
    end

    pcall(function()
        if isfile and isfile(LOGO_FILE) then
            asset = resolveLocal()
        end
    end)

    if not asset and writefile then
        pcall(function()
            if makefolder then
                local createFolder = true

                if isfolder then
                    createFolder = not isfolder(LOGO_FOLDER)
                end

                if createFolder then
                    makefolder(LOGO_FOLDER)
                end
            end

            local bytes = game:HttpGet(LOGO_URL)
            writefile(LOGO_FILE, bytes)

            asset = resolveLocal()
        end)
    end

    ENV.__DanloHubLogoAsset = asset
    return asset
end


local function clearLoadingShield()
    for _, connection in ipairs(State.shieldConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(State.shieldConnections)

    for screen, wasEnabled in pairs(State.shieldedScreens) do
        if screen and screen.Parent and screen ~= State.animScreen then
            pcall(function()
                screen.Enabled = wasEnabled
            end)
        end
    end

    State.shieldedScreens = setmetatable({}, {__mode = "k"})
end

local function shieldScreen(screen)
    if not screen or not screen:IsA("ScreenGui") then
        return
    end

    if State.loadingGui and screen == State.loadingGui then
        return
    end

    if State.shieldedScreens[screen] ~= nil then
        return
    end

    local wasEnabled = true

    pcall(function()
        wasEnabled = screen.Enabled
    end)

    State.shieldedScreens[screen] = wasEnabled

    pcall(function()
        screen.Enabled = false
    end)
end

local function startLoadingShield()
    clearLoadingShield()

    local shieldRoots = {}
    local seen = {}

    local function addRoot(root)
        if root and not seen[root] then
            seen[root] = true
            table.insert(shieldRoots, root)
        end
    end

    -- PlayerGui contains the game's own buttons such as COMBATE.
    addRoot(PlayerGui)

    -- Executor GUI root, if available.
    pcall(function()
        if gethui then
            addRoot(gethui())
        end
    end)

    for _, root in ipairs(shieldRoots) do
        -- Hide every existing ScreenGui while loading.
        if root:IsA("ScreenGui") then
            shieldScreen(root)
        else
            for _, child in ipairs(root:GetChildren()) do
                if child:IsA("ScreenGui") then
                    shieldScreen(child)
                end
            end
        end

        -- Also hide ScreenGuis created a fraction later.
        local connection = root.ChildAdded:Connect(function(child)
            if State.loading and child:IsA("ScreenGui") then
                task.defer(function()
                    if State.loading and child and child.Parent then
                        shieldScreen(child)
                    end
                end)
            end
        end)

        table.insert(State.shieldConnections, connection)
    end
end

local function hideLoading()
    if State.pulseTween then
        pcall(function()
            State.pulseTween:Cancel()
        end)

        State.pulseTween = nil
    end

    if State.loadingGui then
        pcall(function()
            State.loadingGui:Destroy()
        end)

        State.loadingGui = nil
    end

    clearLoadingShield()
end

