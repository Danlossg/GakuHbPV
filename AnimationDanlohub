local function getText(obj)
    if obj and (
        obj:IsA("TextLabel")
        or obj:IsA("TextButton")
        or obj:IsA("TextBox")
    ) then
        local ok, value = pcall(function()
            return obj.Text
        end)

        if ok then
            return tostring(value or "")
        end
    end

    return ""
end

local function getScreenGui(obj)
    local current = obj

    while current do
        if current:IsA("ScreenGui") then
            return current
        end

        current = current.Parent
    end

    return nil
end


local function isDanloHubPlusLauncherScreen(screen)
    if not screen or not screen:IsA("ScreenGui") then
        return false
    end

    -- Base modular v3 marks itself explicitly.
    local ok, marked = pcall(function()
        return screen:GetAttribute("DanloHubPlusLauncher") == true
    end)

    if ok and marked then
        return true
    end

    -- Compatibility with v1/v2 launcher names.
    local name = tostring(screen.Name or "")

    if name == "DanloHubPlus_Base"
        or string.find(name, "DanloHubPlus", 1, true)
        or string.find(name, "DanloHubPlus_Base", 1, true) then
        return true
    end

    -- Last-resort semantic guard:
    -- if this ScreenGui contains the DANLOHUB + title, it is the launcher,
    -- NOT the original Bundle Animations GUI.
    for _, obj in ipairs(screen:GetDescendants()) do
        if string.upper(getText(obj)) == "DANLOHUB +" then
            return true
        end
    end

    return false
end

local function addCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent
end

local function getLogoAsset()
    if ENV.__DanloHubLogoAsset then
        return ENV.__DanloHubLogoAsset
    end

    local asset = nil

    local function resolveLocal()
        if getsynasset then
            local ok, value = pcall(function()
                return getsynasset(LOGO_FILE)
            end)

            if ok and value then
                return value
            end
        end

        if getcustomasset then
            local ok, value = pcall(function()
                return getcustomasset(LOGO_FILE)
            end)

            if ok and value then
                return value
            end
        end

        return nil
    end

    pcall(function()
        if isfile and isfile(LOGO_FILE) then
            asset = resolveLocal()
        end
    end)

    if not asset and writefile then
        pcall(function()
            if makefolder then
                local createFolder = true

                if isfolder then
                    createFolder = not isfolder(LOGO_FOLDER)
                end

                if createFolder then
                    makefolder(LOGO_FOLDER)
                end
            end

            local bytes = game:HttpGet(LOGO_URL)
            writefile(LOGO_FILE, bytes)

            asset = resolveLocal()
        end)
    end

    ENV.__DanloHubLogoAsset = asset
    return asset
end


local function clearLoadingShield()
    for _, connection in ipairs(State.shieldConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(State.shieldConnections)

    for screen, wasEnabled in pairs(State.shieldedScreens) do
        if screen and screen.Parent and screen ~= State.animScreen then
            pcall(function()
                screen.Enabled = wasEnabled
            end)
        end
    end

    for obj, wasVisible in pairs(State.shieldedObjects) do
        if obj and obj.Parent then
            pcall(function()
                obj.Visible = wasVisible
            end)
        end
    end

    State.shieldedScreens = setmetatable({}, {__mode = "k"})
    State.shieldedObjects = setmetatable({}, {__mode = "k"})
end

local function shieldScreen(screen)
    if not screen or not screen:IsA("ScreenGui") then
        return
    end

    if State.loadingGui and screen == State.loadingGui then
        return
    end

    for _, loadingScreen in ipairs(State.loadingGuis) do
        if screen == loadingScreen then
            return
        end
    end

    if string.find(tostring(screen.Name or ""), "DanloHubAnimationsLoadingCoverV5", 1, true) then
        return
    end

    if State.shieldedScreens[screen] ~= nil then
        return
    end

    local wasEnabled = true

    pcall(function()
        wasEnabled = screen.Enabled
    end)

    State.shieldedScreens[screen] = wasEnabled

    pcall(function()
        screen.Enabled = false
    end)
end


local function shieldGuiObject(obj)
    if not obj or not obj:IsA("GuiObject") then
        return
    end

    if State.loadingGui and obj:IsDescendantOf(State.loadingGui) then
        return
    end

    for _, loadingScreen in ipairs(State.loadingGuis) do
        if loadingScreen and loadingScreen.Parent and obj:IsDescendantOf(loadingScreen) then
            return
        end
    end

    if State.shieldedObjects[obj] ~= nil then
        return
    end

    local wasVisible = true

    pcall(function()
        wasVisible = obj.Visible
    end)

    State.shieldedObjects[obj] = wasVisible

    pcall(function()
        obj.Visible = false
    end)
end

local function shouldShieldCombatObject(obj)
    if not obj then
        return false
    end

    if not (
        obj:IsA("TextButton")
        or obj:IsA("TextLabel")
        or obj:IsA("TextBox")
    ) then
        return false
    end

    local text = string.upper(getText(obj))

    return string.find(text, "SIN COMBATE", 1, true) ~= nil
        or string.find(text, "COMBATE:", 1, true) ~= nil
end

local function shieldCombatOverlaysOnce()
    for _, root in ipairs(getRoots()) do
        for _, obj in ipairs(root:GetDescendants()) do
            if shouldShieldCombatObject(obj) then
                -- Hide the button/container itself temporarily.
                if obj:IsA("GuiObject") then
                    shieldGuiObject(obj)
                end

                local parent = obj.Parent

                if parent and parent:IsA("GuiObject") then
                    shieldGuiObject(parent)
                end
            end
        end
    end
end

local function startLoadingShield()
    clearLoadingShield()

    -- V6 CHAT-SAFE:
    -- NO desactivamos ScreenGui de PlayerGui/CoreGui/gethui.
    -- Las capas negras creadas por showLoading() ya cubren visualmente
    -- la pantalla. Apagar las GUI del juego puede romper chats/UI
    -- que reconstruyen estado mientras estan Disabled.
    local shieldRoots = {}
    local seen = {}

    local function addRoot(root)
        if root and not seen[root] then
            seen[root] = true
            table.insert(shieldRoots, root)
        end
    end

    addRoot(PlayerGui)
    addRoot(CoreGui)

    pcall(function()
        if gethui then
            addRoot(gethui())
        end
    end)

    -- Solo vigilamos overlays concretos de combate durante la carga.
    -- Es por eventos; no hay Heartbeat ni scan continuo de todas las GUI.
    for _, root in ipairs(shieldRoots) do
        local descendantConnection = root.DescendantAdded:Connect(function(obj)
            if State.loading and shouldShieldCombatObject(obj) then
                task.defer(function()
                    if State.loading and obj and obj.Parent then
                        shieldGuiObject(obj)

                        local parent = obj.Parent

                        if parent and parent:IsA("GuiObject") then
                            shieldGuiObject(parent)
                        end
                    end
                end)
            end
        end)

        table.insert(State.shieldConnections, descendantConnection)
    end

    shieldCombatOverlaysOnce()
end

local function destroyLoadingLayers()
    if State.pulseTween then
        pcall(function()
            State.pulseTween:Cancel()
        end)
        State.pulseTween = nil
    end

    for _, gui in ipairs(State.loadingGuis) do
        pcall(function()
            gui:Destroy()
        end)
    end

    table.clear(State.loadingGuis)
    State.loadingGui = nil
end

local function purgeOldLoadingCovers()
    -- Pasada finita; elimina covers huerfanos de cualquier version.
    for _, root in ipairs(getRoots()) do
        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("ScreenGui") then
                local name = tostring(obj.Name or "")
                if string.find(name, "DanloHubAnimationsLoadingCover", 1, true) == 1 then
                    pcall(function()
                        obj:Destroy()
                    end)
                end
            end
        end
    end
end

local function hideLoading()
    destroyLoadingLayers()
    clearLoadingShield()
    purgeOldLoadingCovers()
end

