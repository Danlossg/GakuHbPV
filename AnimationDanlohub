local function showLoading()
    destroyLoadingLayers()
    clearLoadingShield()
    purgeOldLoadingCovers()

    -- V5: create the black cover in EVERY relevant GUI root.
    -- This matters because DisplayOrder from a ScreenGui in one root does
    -- not always dominate a ScreenGui living in another root.
    local parents = {}
    local seen = {}

    local function addParent(parent)
        if parent and not seen[parent] then
            seen[parent] = true
            table.insert(parents, parent)
        end
    end

    addParent(PlayerGui)

    pcall(function()
        addParent(CoreGui)
    end)

    pcall(function()
        if gethui then
            addParent(gethui())
        end
    end)

    local preferred = getGuiParent()
    addParent(preferred)

    -- Create blocker layers first.
    for i, parent in ipairs(parents) do
        createLoadingLayer(parent, false, i)
    end

    -- Add the visible card to the preferred/top executor root.
    local cardLayer = createLoadingLayer(preferred, true, #parents + 1)

    if cardLayer then
        State.loadingGui = cardLayer
    elseif State.loadingGuis[1] then
        State.loadingGui = State.loadingGuis[1]
    end

    -- Now disable other ScreenGuis while preserving our loading layers.
    startLoadingShield()

    -- Targeted cleanup for combat badges, including text that changes
    -- after the object was already created.
    task.spawn(function()
        local passes = 0

        while State.loading and State.loadingGui and passes < 40 do
            passes = passes + 1
            shieldCombatOverlaysOnce()
            task.wait(0.10)
        end
    end)
end

local function findBundleScreen()
    -- 1) Prefer the actual original ScreenGui by name.
    for _, root in ipairs(getRoots()) do
        local exact = root:FindFirstChild("BundleAnimGui", true)

        if exact
            and exact:IsA("ScreenGui")
            and not isDanloHubPlusLauncherScreen(exact) then

            return exact
        end
    end

    -- 2) Fallback: only accept a ScreenGui that contains the animation title
    -- AND is definitely not the DanloHub + launcher.
    for _, root in ipairs(getRoots()) do
        for _, obj in ipairs(root:GetDescendants()) do
            local upper = string.upper(getText(obj))

            if upper == "BUNDLE ANIMATIONS"
                or upper == "DANLOHUB ANIMATIONS" then

                local screen = getScreenGui(obj)

                if screen
                    and not isDanloHubPlusLauncherScreen(screen) then

                    return screen
                end
            end
        end
    end

    return nil
end

local function findTitle(screen)
    if not screen or isDanloHubPlusLauncherScreen(screen) then
        return nil
    end

    for _, obj in ipairs(screen:GetDescendants()) do
        local upper = string.upper(getText(obj))

        if upper == "BUNDLE ANIMATIONS"
            or upper == "DANLOHUB ANIMATIONS" then

            return obj
        end
    end

    return nil
end

local function patchHeader(screen, title)
    if not screen
        or not title
        or not title.Parent
        or isDanloHubPlusLauncherScreen(screen) then
        return false
    end

    local header = title.Parent
    local main = header.Parent

    if not main or not main:IsA("GuiObject") then
        return false
    end

    State.animScreen = screen
    State.animMain = main
    State.title = title

    pcall(function()
        title.Text = "DANLOHUB ANIMATIONS"
        title.TextColor3 = Color3.fromRGB(255, 70, 105)
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Position = UDim2.new(0, 48, 0, 0)
        title.Size = UDim2.new(1, -90, 1, 0)
    end)

    for _, child in ipairs(header:GetChildren()) do
        if child ~= title
            and child.Name ~= "DanloHubCustomLogo"
            and (
                child:IsA("GuiButton")
                or child:IsA("ImageButton")
                or child:IsA("ImageLabel")
            ) then

            if child.AbsolutePosition.X < title.AbsolutePosition.X then
                pcall(function()
                    child:Destroy()
                end)
            end
        end
    end

    local oldLogo = header:FindFirstChild("DanloHubCustomLogo")

    if oldLogo then
        oldLogo:Destroy()
    end

    local logo = Instance.new("ImageLabel")
    logo.Name = "DanloHubCustomLogo"
    logo.BackgroundTransparency = 1
    logo.BorderSizePixel = 0
    logo.Position = UDim2.fromOffset(12, 9)
    logo.Size = UDim2.fromOffset(26, 26)
    logo.ZIndex = title.ZIndex
    logo.Parent = header
    addCorner(logo, 6)

    local asset = getLogoAsset()

    if asset then
        logo.Image = asset
    end

    return true
end

