local function clearPromoBlocker()
    for _, connection in ipairs(State.promoConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(State.promoConnections)
    State.promoTarget = nil
end

local function forcePromoHidden(promo)
    if not promo
        or not promo.Parent
        or not promo:IsA("GuiObject") then
        return
    end

    pcall(function()
        promo.Visible = false
        promo.Active = false
    end)
end

local function attachPromoBlocker(screen)
    clearPromoBlocker()

    if not screen
        or not screen.Parent
        or not screen:IsA("ScreenGui") then
        return
    end

    local function hookPromo(promo)
        if not promo
            or not promo.Parent
            or not promo:IsA("GuiObject") then
            return
        end

        -- Evita duplicar conexion al mismo TgPromo.
        if State.promoTarget == promo then
            forcePromoHidden(promo)
            return
        end

        State.promoTarget = promo
        forcePromoHidden(promo)

        local visibleConnection =
            promo:GetPropertyChangedSignal("Visible"):Connect(function()
                if State.promoTarget ~= promo
                    or not promo.Parent then
                    return
                end

                if promo.Visible then
                    forcePromoHidden(promo)
                end
            end)

        table.insert(State.promoConnections, visibleConnection)

        local ancestryConnection =
            promo.AncestryChanged:Connect(function(_, parent)
                if State.promoTarget == promo and parent == nil then
                    State.promoTarget = nil
                end
            end)

        table.insert(State.promoConnections, ancestryConnection)
    end

    local existingPromo = screen:FindFirstChild("TgPromo", true)

    if existingPromo then
        hookPromo(existingPromo)
    end

    local addedConnection =
        screen.DescendantAdded:Connect(function(obj)
            if obj.Name == "TgPromo" then
                task.defer(function()
                    if obj and obj.Parent then
                        hookPromo(obj)
                    end
                end)
            end
        end)

    table.insert(State.promoConnections, addedConnection)
end

local PROMO_WORDS = {
    "t.me/arceusxcommunity",
    "join my channel",
    "free scripts here",
    "copy link",
    "hide for now",
    "don't show again",
    "dont show again"
}

local function isPromo(text)
    text = string.lower(tostring(text or ""))

    for _, word in ipairs(PROMO_WORDS) do
        if string.find(text, word, 1, true) then
            return true
        end
    end

    return false
end

local function cleanupExtras()
    -- V7: no escanear PlayerGui/CoreGui completos buscando promos.
    -- La promo confirmada vive dentro de BundleAnimGui.
    local promoRoots = {}
    if State.animScreen and State.animScreen.Parent then
        promoRoots[1] = State.animScreen
    end

    for _, root in ipairs(promoRoots) do
        local framesToHide = {}

        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("TextLabel")
                or obj:IsA("TextButton")
                or obj:IsA("TextBox") then

                if isPromo(getText(obj)) then
                    local current = obj

                    for _ = 1, 12 do
                        if not current then
                            break
                        end

                        if current:IsA("Frame") then
                            framesToHide[current] = true
                        end

                        if current:IsA("ScreenGui") then
                            break
                        end

                        current = current.Parent
                    end
                end
            end
        end

        for frame in pairs(framesToHide) do
            pcall(function()
                frame.Visible = false
            end)
        end
    end

    if State.animScreen and State.animMain then
        for _, obj in ipairs(State.animScreen:GetDescendants()) do
            if obj:IsA("GuiButton")
                and not obj:IsDescendantOf(State.animMain) then

                local size = obj.AbsoluteSize

                if size.X <= 110 and size.Y <= 110 then
                    local text = getText(obj)
                    local play = (
                        text == ">"
                        or text == "▶"
                        or text == "►"
                        or text == "▷"
                    )

                    if not play then
                        for _, d in ipairs(obj:GetDescendants()) do
                            local t = getText(d)

                            if t == ">"
                                or t == "▶"
                                or t == "►"
                                or t == "▷" then

                                play = true
                                break
                            end
                        end
                    end

                    if play then
                        pcall(function()
                            obj:Destroy()
                        end)
                    end
                end
            end
        end
    end
end

local function attachTitleProtection()
    clearConnections()

    if State.title and State.title.Parent then
        keep(State.title:GetPropertyChangedSignal("Text"):Connect(function()
            if State.enabled
                and State.title
                and State.title.Parent
                and string.upper(getText(State.title)) ~= "DANLOHUB ANIMATIONS" then

                State.title.Text = "DANLOHUB ANIMATIONS"
                State.title.TextColor3 = Color3.fromRGB(255, 70, 105)
            end
        end))
    end
end

function Module.Start()
    purgeOldLoadingCovers()

    if State.loading then
        return false, "loading"
    end

    local existing = findBundleScreen()

    if existing then
        local title = findTitle(existing)

        if title then
            State.enabled = true
            State.loading = false

            -- V7: no alternar Enabled del BundleAnimGui.
            State.shieldedScreens[existing] = nil

            patchHeader(existing, title)
            attachPromoBlocker(existing)
            cleanupExtras()
            attachTitleProtection()

            if State.animMain then
                State.animMain.Visible = true
            end

            return true
        end
    end

    State.loading = true
    State.enabled = false

    showLoading()

    task.spawn(function()
        local ok, err = pcall(function()
            local source = game:HttpGet(ORIGINAL_URL)
            local fn, compileErr = loadstring(source)

            if not fn then
                error(compileErr or "No se pudo compilar BundleAnimations.lua")
            end

            fn()
        end)

        if not ok then
            warn("[DanloHub Animations Module v7] Loader:", err)
        end
    end)

    task.spawn(function()
        local screen = nil
        local title = nil

        for _ = 1, 80 do
            screen = findBundleScreen()

            if screen then
                title = findTitle(screen)

                if title then
                    break
                end
            end

            task.wait(0.10)
        end

        if not screen or not title then
            State.loading = false
            State.enabled = false
            hideLoading()

            warn("[DanloHub Animations Module v7] No se encontro la interfaz.")
            return
        end

        -- V7: no desactivar el ScreenGui original durante el parcheo.
        State.shieldedScreens[screen] = nil

        for _ = 1, 5 do
            patchHeader(screen, title)
            cleanupExtras()
            task.wait(0.08)
        end

        -- El checker confirmo que el anuncio vive en:
        -- BundleAnimGui.TgPromo
        -- Lo bloqueamos antes de volver a mostrar la interfaz.
        attachPromoBlocker(screen)

        State.enabled = true
        State.loading = false

        attachTitleProtection()

        patchHeader(screen, title)
        cleanupExtras()
        attachPromoBlocker(screen)

        if State.animMain then
            State.animMain.Visible = true
        end

        hideLoading()

        -- Only finite late cleanup passes.
        task.delay(0.30, cleanupExtras)
        task.delay(1.00, cleanupExtras)
        task.delay(2.50, cleanupExtras)
    end)

    return true
end

function Module.Open()
    purgeOldLoadingCovers()

    if not State.enabled then
        return Module.Start()
    end

    if State.animMain and State.animMain.Parent then
        if State.animScreen and State.animScreen.Parent then
            attachPromoBlocker(State.animScreen)
        end

        cleanupExtras()
        State.animMain.Visible = true
        return true
    end

    State.enabled = false
    return Module.Start()
end

function Module.Close()
    if State.animMain and State.animMain.Parent then
        State.animMain.Visible = false
        return true
    end

    return false
end

function Module.Toggle()
    if not State.enabled then
        return Module.Start()
    end

    if State.animMain and State.animMain.Parent then
        if State.animMain.Visible then
            return Module.Close()
        else
            return Module.Open()
        end
    end

    State.enabled = false
    return Module.Start()
end

function Module.Destroy()
    State.enabled = false
    State.loading = false

    hideLoading()
    clearConnections()
    clearPromoBlocker()

    if State.animScreen
        and State.animScreen.Parent
        and not isDanloHubPlusLauncherScreen(State.animScreen) then

        pcall(function()
            State.animScreen:Destroy()
        end)
    end

    State.animMain = nil
    State.animScreen = nil
    State.title = nil

    return true
end

function Module.IsRunning()
    return State.enabled == true
end

function Module.IsLoading()
    return State.loading == true
end

return Module
