local function findBundleScreen()
    -- 1) Prefer the actual original ScreenGui by name.
    for _, root in ipairs(getRoots()) do
        local exact = root:FindFirstChild("BundleAnimGui", true)

        if exact
            and exact:IsA("ScreenGui")
            and not isDanloHubPlusLauncherScreen(exact) then

            return exact
        end
    end

    -- 2) Fallback: only accept a ScreenGui that contains the animation title
    -- AND is definitely not the DanloHub + launcher.
    for _, root in ipairs(getRoots()) do
        for _, obj in ipairs(root:GetDescendants()) do
            local upper = string.upper(getText(obj))

            if upper == "BUNDLE ANIMATIONS"
                or upper == "DANLOHUB ANIMATIONS" then

                local screen = getScreenGui(obj)

                if screen
                    and not isDanloHubPlusLauncherScreen(screen) then

                    return screen
                end
            end
        end
    end

    return nil
end

local function findTitle(screen)
    if not screen or isDanloHubPlusLauncherScreen(screen) then
        return nil
    end

    for _, obj in ipairs(screen:GetDescendants()) do
        local upper = string.upper(getText(obj))

        if upper == "BUNDLE ANIMATIONS"
            or upper == "DANLOHUB ANIMATIONS" then

            return obj
        end
    end

    return nil
end

local function patchHeader(screen, title)
    if not screen
        or not title
        or not title.Parent
        or isDanloHubPlusLauncherScreen(screen) then
        return false
    end

    local header = title.Parent
    local main = header.Parent

    if not main or not main:IsA("GuiObject") then
        return false
    end

    State.animScreen = screen
    State.animMain = main
    State.title = title

    pcall(function()
        title.Text = "DANLOHUB ANIMATIONS"
        title.TextColor3 = Color3.fromRGB(255, 70, 105)
        title.Font = Enum.Font.GothamBold
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.Position = UDim2.new(0, 48, 0, 0)
        title.Size = UDim2.new(1, -90, 1, 0)
    end)

    for _, child in ipairs(header:GetChildren()) do
        if child ~= title
            and child.Name ~= "DanloHubCustomLogo"
            and (
                child:IsA("GuiButton")
                or child:IsA("ImageButton")
                or child:IsA("ImageLabel")
            ) then

            if child.AbsolutePosition.X < title.AbsolutePosition.X then
                pcall(function()
                    child:Destroy()
                end)
            end
        end
    end

    local oldLogo = header:FindFirstChild("DanloHubCustomLogo")

    if oldLogo then
        oldLogo:Destroy()
    end

    local logo = Instance.new("ImageLabel")
    logo.Name = "DanloHubCustomLogo"
    logo.BackgroundTransparency = 1
    logo.BorderSizePixel = 0
    logo.Position = UDim2.fromOffset(12, 9)
    logo.Size = UDim2.fromOffset(26, 26)
    logo.ZIndex = title.ZIndex
    logo.Parent = header
    addCorner(logo, 6)

    local asset = getLogoAsset()

    if asset then
        logo.Image = asset
    end

    return true
end

local PROMO_WORDS = {
    "t.me/arceusxcommunity",
    "join my channel",
    "free scripts here",
    "copy link",
    "hide for now",
    "don't show again",
    "dont show again"
}

local function isPromo(text)
    text = string.lower(tostring(text or ""))

    for _, word in ipairs(PROMO_WORDS) do
        if string.find(text, word, 1, true) then
            return true
        end
    end

    return false
end

local function cleanupExtras()
    for _, root in ipairs(getRoots()) do
        local framesToHide = {}

        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("TextLabel")
                or obj:IsA("TextButton")
                or obj:IsA("TextBox") then

                if isPromo(getText(obj)) then
                    local current = obj

                    for _ = 1, 12 do
                        if not current then
                            break
                        end

                        if current:IsA("Frame") then
                            framesToHide[current] = true
                        end

                        if current:IsA("ScreenGui") then
                            break
                        end

                        current = current.Parent
                    end
                end
            end
        end

        for frame in pairs(framesToHide) do
            pcall(function()
                frame.Visible = false
            end)
        end
    end

    if State.animScreen and State.animMain then
        for _, obj in ipairs(State.animScreen:GetDescendants()) do
            if obj:IsA("GuiButton")
                and not obj:IsDescendantOf(State.animMain) then

                local size = obj.AbsoluteSize

                if size.X <= 110 and size.Y <= 110 then
                    local text = getText(obj)
                    local play = (
                        text == ">"
                        or text == "▶"
                        or text == "►"
                        or text == "▷"
                    )

                    if not play then
                        for _, d in ipairs(obj:GetDescendants()) do
                            local t = getText(d)

                            if t == ">"
                                or t == "▶"
                                or t == "►"
                                or t == "▷" then

                                play = true
                                break
                            end
                        end
                    end

                    if play then
                        pcall(function()
                            obj:Destroy()
                        end)
                    end
                end
            end
        end
    end
end

local function attachTitleProtection()
    clearConnections()

    if State.title and State.title.Parent then
        keep(State.title:GetPropertyChangedSignal("Text"):Connect(function()
            if State.enabled
                and State.title
                and State.title.Parent
                and string.upper(getText(State.title)) ~= "DANLOHUB ANIMATIONS" then

                State.title.Text = "DANLOHUB ANIMATIONS"
                State.title.TextColor3 = Color3.fromRGB(255, 70, 105)
            end
        end))
    end
end

function Module.Start()
    if State.loading then
        return false, "loading"
    end

    local existing = findBundleScreen()

    if existing then
        local title = findTitle(existing)

        if title then
            State.enabled = true
            State.loading = false

            pcall(function()
                existing.Enabled = false
            end)

            State.shieldedScreens[existing] = nil

            patchHeader(existing, title)
            cleanupExtras()
            attachTitleProtection()

            pcall(function()
                existing.Enabled = true
            end)

            if State.animMain then
                State.animMain.Visible = true
            end

            return true
        end
    end

    State.loading = true
    State.enabled = false

    showLoading()

    task.spawn(function()
        local ok, err = pcall(function()
            local source = game:HttpGet(ORIGINAL_URL)
            local fn, compileErr = loadstring(source)

            if not fn then
                error(compileErr or "No se pudo compilar BundleAnimations.lua")
            end

            fn()
        end)

        if not ok then
            warn("[DanloHub Animations Module v3] Loader:", err)
        end
    end)

    task.spawn(function()
        local screen = nil
        local title = nil

        for _ = 1, 80 do
            screen = findBundleScreen()

            if screen then
                title = findTitle(screen)

                if title then
                    break
                end
            end

            task.wait(0.10)
        end

        if not screen or not title then
            State.loading = false
            State.enabled = false
            hideLoading()

            warn("[DanloHub Animations Module v3] No se encontro la interfaz.")
            return
        end

        pcall(function()
            screen.Enabled = false
        end)

        -- This one is intentionally controlled by the module itself.
        State.shieldedScreens[screen] = nil

        for _ = 1, 5 do
            patchHeader(screen, title)
            cleanupExtras()
            task.wait(0.08)
        end

        State.enabled = true
        State.loading = false

        attachTitleProtection()

        patchHeader(screen, title)
        cleanupExtras()

        pcall(function()
            screen.Enabled = true
        end)

        if State.animMain then
            State.animMain.Visible = true
        end

        hideLoading()

        -- Only finite late cleanup passes.
        task.delay(0.30, cleanupExtras)
        task.delay(1.00, cleanupExtras)
        task.delay(2.50, cleanupExtras)
    end)

    return true
end

function Module.Open()
    if not State.enabled then
        return Module.Start()
    end

    if State.animMain and State.animMain.Parent then
        cleanupExtras()
        State.animMain.Visible = true
        return true
    end

    State.enabled = false
    return Module.Start()
end

function Module.Close()
    if State.animMain and State.animMain.Parent then
        State.animMain.Visible = false
        return true
    end

    return false
end

function Module.Toggle()
    if not State.enabled then
        return Module.Start()
    end

    if State.animMain and State.animMain.Parent then
        if State.animMain.Visible then
            return Module.Close()
        else
            return Module.Open()
        end
    end

    State.enabled = false
    return Module.Start()
end

function Module.Destroy()
    State.enabled = false
    State.loading = false

    hideLoading()
    clearConnections()

    if State.animScreen
        and State.animScreen.Parent
        and not isDanloHubPlusLauncherScreen(State.animScreen) then

        pcall(function()
            State.animScreen:Destroy()
        end)
    end

    State.animMain = nil
    State.animScreen = nil
    State.title = nil

    return true
end

function Module.IsRunning()
    return State.enabled == true
end

function Module.IsLoading()
    return State.loading == true
end

return 
